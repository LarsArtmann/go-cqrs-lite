{
    "engines": {
        "primary": {
            "driver": "postgres",
            "dsn": "postgres:///cqrs_demo_primary?host=/run/postgresql&user=cqrs_demo_primary"
        },
        "proj": {
            "driver": "sqlite",
            "dsn": "file:/var/lib/cqrs/demo/proj.db"
        }
    },
    "instances": [
        {
            "collections": [
                "events",
                "commands",
                "queries",
                "snapshots",
                "checkpoints"
            ],
            "engine": "primary",
            "role": "source-of-truth"
        },
        {
            "collections": [
                "queries"
            ],
            "engine": "primary",
            "role": "queries"
        },
        {
            "collections": [
                "projections"
            ],
            "engines": [
                "primary",
                "proj"
            ],
            "role": "projections"
        }
    ]
}
