package docserver

import (
	"strconv"

	"github.com/larsartmann/templ-components/display"
	"github.com/larsartmann/templ-components/layout"
)

// IndexPage renders the documentation landing page: catalog stats, links to
// every generated artifact, and one card per service.
templ IndexPage(data indexPageData) {
	{{
		base := docsPageProps(data.CatalogTitle+" — API Documentation", data.Description, data.DocsPath)
		headerProps := display.PageHeaderProps{
			Title:    data.CatalogTitle,
			Subtitle: data.Description,
			Action:   display.Badge(display.BadgeProps{Text: "v" + data.Version, Type: display.BadgeInfo, Pill: true}),
		}
	}}
	@layout.Base(base) {
		@docsNav(data.Brand, data.DocsPath, data.DocsPath)
		<div class="mx-auto w-full max-w-7xl px-4 pb-16 pt-8 sm:px-6 lg:px-8">
			@display.PageHeader(headerProps)
			@statGrid(data)
			@sectionHeading("Documentation")
			@display.Grid(display.GridProps{Cols: display.GridCols2, Gap: display.GridGapLG}) {
				for _, link := range data.Specs {
					@specCard(link)
				}
			}
			if len(data.Services) > 0 {
				@sectionHeading("Services")
				@display.Grid(display.GridProps{Cols: display.GridCols3, Gap: display.GridGapLG}) {
					for _, svc := range data.Services {
						@serviceSummaryCard(svc)
					}
				}
			}
		</div>
	}
}

// statGrid renders the deduplicated catalog counters.
templ statGrid(data indexPageData) {
	@display.Grid(display.GridProps{Cols: display.GridCols4}) {
		@display.StatCard(display.StatCardProps{Value: strconv.Itoa(data.Stats.Services), Label: "Services"})
		@display.StatCard(display.StatCardProps{Value: strconv.Itoa(data.Stats.Commands), Label: "Commands"})
		@display.StatCard(display.StatCardProps{Value: strconv.Itoa(data.Stats.Events), Label: "Events"})
		@display.StatCard(display.StatCardProps{Value: strconv.Itoa(data.Stats.Queries), Label: "Queries"})
	}
}

// specCard is one documentation artifact card: a primary link plus optional
// raw artifact links.
templ specCard(link specLink) {
	{{ cardProps := display.CardProps{Title: link.Title, Subtitle: link.Subtitle} }}
	@display.Card(cardProps) {
		<a
			href={ templ.SafeURL(link.PageHref) }
			class="text-sm font-medium text-blue-600 hover:underline dark:text-blue-400"
		>Open { link.Title }</a>
		if len(link.Raw) > 0 {
			<p class="mt-2 text-xs text-gray-500 dark:text-gray-400">
				Raw:
				for i, raw := range link.Raw {
					if i > 0 {
						·
					}
					<a
						href={ templ.SafeURL(raw.Href) }
						class="font-medium text-blue-600 hover:underline dark:text-blue-400"
					>{ raw.Label }</a>
				}
			</p>
		}
	}
}

// serviceSummaryCard shows one service with its message counts.
templ serviceSummaryCard(svc serviceCard) {
	{{ cardProps := display.CardProps{Title: svc.Name, Subtitle: svc.ID + " · v" + svc.Version} }}
	@display.Card(cardProps) {
		if svc.Summary != "" {
			<p class="text-sm text-gray-600 dark:text-gray-400">{ svc.Summary }</p>
		}
		<div class="mt-3 flex flex-wrap gap-2">
			if svc.Commands > 0 {
				@display.Badge(display.BadgeProps{Text: strconv.Itoa(svc.Commands) + " commands", Type: display.BadgePrimary})
			}
			if svc.Events > 0 {
				@display.Badge(display.BadgeProps{Text: strconv.Itoa(svc.Events) + " events", Type: display.BadgeSuccess})
			}
			if svc.Queries > 0 {
				@display.Badge(display.BadgeProps{Text: strconv.Itoa(svc.Queries) + " queries", Type: display.BadgeInfo})
			}
		</div>
	}
}
