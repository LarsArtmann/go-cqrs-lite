package docserver

import (
	"strconv"

	"github.com/larsartmann/templ-components/display"
	"github.com/larsartmann/templ-components/icons"
	"github.com/larsartmann/templ-components/layout"
)

// IndexPage renders the documentation landing page: catalog stats, links to
// every generated artifact, and one card per service.
templ IndexPage(data indexPageData) {
	{{
		base := docsPageProps(data.CatalogTitle+" — API Documentation", data.Description, data.DocsPath, templ.GetNonce(ctx))
		headerProps := display.PageHeaderProps{
			Title:    data.CatalogTitle,
			Subtitle: data.Description,
			Action:   display.Badge(display.BadgeProps{Text: "v" + data.Version, Type: display.BadgeInfo, Pill: true}),
		}
	}}
	@layout.Base(base) {
		@docsNav(data.Brand, data.DocsPath, data.DocsPath)
		<div class="mx-auto w-full max-w-7xl px-4 pb-16 pt-8 sm:px-6 lg:px-8">
			@display.PageHeader(headerProps)
			@statGrid(data)
			@sectionHeading("Documentation")
			@display.Grid(display.GridProps{Cols: display.GridCols2, Gap: display.GridGapLG}) {
				for _, link := range data.Specs {
					@specCard(link)
				}
			}
			if len(data.Services) > 0 {
				@sectionHeading("Services")
				@display.Grid(display.GridProps{Cols: display.GridCols3, Gap: display.GridGapLG}) {
					for _, svc := range data.Services {
						@serviceSummaryCard(svc)
					}
				}
			}
		</div>
	}
}

// statGrid renders the deduplicated catalog counters with semantic icons.
templ statGrid(data indexPageData) {
	@display.Grid(display.GridProps{Cols: display.GridCols3}) {
		@display.StatCard(display.StatCardProps{Value: strconv.Itoa(data.Stats.Services), Label: "Services", Icon: icons.Server, Tone: display.StatTonePurple})
		@display.StatCard(display.StatCardProps{Value: strconv.Itoa(data.Stats.Commands), Label: "Commands", Icon: icons.ArrowUpOnSquare, Tone: display.StatToneBlue})
		@display.StatCard(display.StatCardProps{Value: strconv.Itoa(data.Stats.Events), Label: "Events", Icon: icons.Bolt, Tone: display.StatToneGreen})
		@display.StatCard(display.StatCardProps{Value: strconv.Itoa(data.Stats.Queries), Label: "Queries", Icon: icons.Search, Tone: display.StatToneYellow})
		@display.StatCard(display.StatCardProps{Value: strconv.Itoa(data.Stats.Channels), Label: "Channels", Icon: icons.Signal, Tone: display.StatToneBlue})
		@display.StatCard(display.StatCardProps{Value: strconv.Itoa(data.Stats.DataStores), Label: "Data stores", Icon: icons.CircleStack, Tone: display.StatTonePurple})
	}
}

// specCard is one documentation artifact card: an icon tile, the artifact
// description, a primary "Open" action, and optional raw artifact links.
templ specCard(link specLink) {
	{{ cardProps := display.CardProps{
		Title:        link.Title,
		HeaderAction: display.Button(display.ButtonProps{Text: "Open", Href: link.PageHref, Variant: display.ButtonPrimary, Size: display.ButtonSizeSM}),
	} }}
	@display.Card(cardProps) {
		<div class="flex items-start gap-3">
			<div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-blue-50 text-blue-600 dark:bg-blue-900/30 dark:text-blue-400">
				@icons.Icon(link.Icon, "h-5 w-5")
			</div>
			<div class="min-w-0 flex-1">
				<p class="text-sm text-gray-600 dark:text-gray-400">{ link.Subtitle }</p>
				if len(link.Raw) > 0 {
					<div class="mt-3 flex flex-wrap items-center gap-2">
						<span class="text-xs text-gray-500 dark:text-gray-400">Raw:</span>
						for _, raw := range link.Raw {
							@display.Badge(display.BadgeProps{Text: raw.Label, Type: display.BadgeNeutral, Size: display.BadgeSizeSM, Href: raw.Href})
						}
					</div>
				}
			</div>
		</div>
	}
}

// serviceSummaryCard shows one service with its message counts.
templ serviceSummaryCard(svc serviceCard) {
	{{ cardProps := display.CardProps{Title: svc.Name, Subtitle: svc.ID + " · v" + svc.Version} }}
	@display.Card(cardProps) {
		if svc.Summary != "" {
			<p class="text-sm text-gray-600 dark:text-gray-400">{ svc.Summary }</p>
		}
		<div class="mt-3 flex flex-wrap gap-2">
			if svc.Commands > 0 {
				@display.Badge(display.BadgeProps{Text: strconv.Itoa(svc.Commands) + " commands", Type: display.BadgePrimary})
			}
			if svc.Events > 0 {
				@display.Badge(display.BadgeProps{Text: strconv.Itoa(svc.Events) + " events", Type: display.BadgeSuccess})
			}
			if svc.Queries > 0 {
				@display.Badge(display.BadgeProps{Text: strconv.Itoa(svc.Queries) + " queries", Type: display.BadgeInfo})
			}
		</div>
	}
}
