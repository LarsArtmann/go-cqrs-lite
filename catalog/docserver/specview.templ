package docserver

import (
	"github.com/larsartmann/templ-components/layout"
)

// ScalarPage wraps the embedded Scalar SPA with a slim chrome. Asset URLs
// are anchored at docsPrefix so the page works under any mount point.
templ ScalarPage(brand, docsPrefix, specURL string) {
	{{
		props := docsPageProps(brand+" — OpenAPI Reference", "Interactive OpenAPI reference rendered by Scalar", docsPrefix, templ.GetNonce(ctx))
		props.BodyClass = "bg-white dark:bg-gray-950"
	}}
	@layout.Base(props) {
		@spaHeader(brand, docsPrefix, "OpenAPI Reference")
		<div id="app" class="h-[calc(100dvh-3.5rem)]" data-spec-url={ specURL }></div>
		<noscript>
			<p class="p-4 text-sm text-gray-700 dark:text-gray-300">
				The Scalar API reference requires JavaScript. The raw OpenAPI spec is available at
				<a href={ templ.SafeURL(specURL) } class="font-medium text-blue-600 hover:underline dark:text-blue-400">the JSON endpoint</a>.
			</p>
		</noscript>
		<script nonce={ templ.GetNonce(ctx) } src={ templ.SafeURL(docsPrefix + "/static/scalar.js") }></script>
		<script nonce={ templ.GetNonce(ctx) }>
			Scalar.createApiReference('#app', {
				spec: {
					url: document.getElementById('app').dataset.specUrl,
				},
			});
		</script>
	}
}

// asyncAPIExtraHead loads the AsyncAPI React stylesheet alongside the shared
// docs stylesheet.
templ asyncAPIExtraHead(docsPrefix string) {
	<link rel="stylesheet" href={ templ.SafeURL(docsPrefix + "/static/asyncapi-react.css") }/>
}

// AsyncAPIPage wraps the embedded AsyncAPI React SPA with a slim chrome.
templ AsyncAPIPage(brand, docsPrefix, specURL string) {
	{{
		props := docsPageProps(brand+" — Event Reference", "Interactive AsyncAPI documentation rendered by AsyncAPI React", docsPrefix, templ.GetNonce(ctx))
		props.BodyClass = "bg-white dark:bg-gray-950"
		props.HeadContent = asyncAPIExtraHead(docsPrefix)
	}}
	@layout.Base(props) {
		@spaHeader(brand, docsPrefix, "Event Reference")
		<div id="asyncapi" class="min-h-[calc(100dvh-3.5rem)]" data-spec-url={ specURL }></div>
		<noscript>
			<p class="p-4 text-sm text-gray-700 dark:text-gray-300">
				The AsyncAPI event reference requires JavaScript. The raw AsyncAPI spec is available at
				<a href={ templ.SafeURL(specURL) } class="font-medium text-blue-600 hover:underline dark:text-blue-400">the JSON endpoint</a>.
			</p>
		</noscript>
		<script nonce={ templ.GetNonce(ctx) } src={ templ.SafeURL(docsPrefix + "/static/asyncapi-react.js") }></script>
		<script nonce={ templ.GetNonce(ctx) }>
			AsyncApiStandalone.render({
				schema: {
					url: document.getElementById('asyncapi').dataset.specUrl,
					options: { method: "GET" },
				},
				config: {
					show: {
						sidebar: true,
						operations: true,
						messages: true,
						schemas: true,
					},
				},
			}, document.getElementById('asyncapi'));
		</script>
	}
}
