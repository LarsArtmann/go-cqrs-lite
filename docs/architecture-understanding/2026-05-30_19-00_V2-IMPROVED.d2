direction: down

title: {
  label: go-cqrs-lite — Ideal Architecture (v2.0.0 target)
  shape: text
  near: top-center
  style.font-size: 28
}

# Layer 0 — Leaf modules
layer0: {
  label: "Layer 0 — Leaf Modules (zero internal deps)"
  shape: rectangle
  style.fill: "#f0fdf4"
  style.stroke: "#86efac"

  id: { label: "id/\nBranded IDs" ; shape: rectangle }
  dispatcher: { label: "dispatcher/\nGeneric Dispatcher[H,M]" ; shape: rectangle }
  codec: { label: "codec/\nJSON + Raw" ; shape: rectangle }
}

# Layer 1 — Core CQRS (no cycles!)
layer1: {
  label: "Layer 1 — Core CQRS (zero cycles)"
  shape: rectangle
  style.fill: "#eff6ff"
  style.stroke: "#93c5fd"

  event: { label: "event/\nStore, Bus, ImmutableEvent\nJournal, Tombstone\nReactive (ro)" ; shape: rectangle  }
  command: { label: "command/\nDispatcher, Handler\nCommandStore" ; shape: rectangle }
  query: { label: "query/\nDispatcher, Handler\nPagination" ; shape: rectangle }
}

# Layer 2 — Schema & Snapshot
layer2: {
  label: "Layer 2 — Schema & Snapshot"
  shape: rectangle
  style.fill: "#fefce8"
  style.stroke: "#fde047"

  schema: { label: "schema/\nUpcaster, VersionedStore" ; shape: rectangle }
  snapshot: { label: "snapshot/\nSnapshot, Strategy\nsnapshottest (FakeStore)" ; shape: rectangle }
}

# Layer 3 — Aggregate Pattern (no memory dependency!)
layer3: {
  label: "Layer 3 — Aggregate Pattern"
  shape: rectangle
  style.fill: "#fdf2f8"
  style.stroke: "#f9a8d4"

  decider: { label: "decider/\nDecider[State], Repository\nExecute, Load\n(no memory dep!)" ; shape: rectangle ; style.stroke: "#22c55e" ; style.stroke-width: 3 }
}

# Layer 4 — In-Memory & Utilities
layer4: {
  label: "Layer 4 — In-Memory & Utilities"
  shape: rectangle
  style.fill: "#f5f3ff"
  style.stroke: "#c4b5fd"

  memory: { label: "memory/\nMemoryStore, Bus\nSnapshotStore, Checkpoint" ; shape: rectangle }
  signing: { label: "signing/\nHMAC, Ed25519\nMultisig (shared extract)" ; shape: rectangle }
  otel: { label: "otel/\nTracer, Meter\nSpans, Attributes\n(no dead code)" ; shape: rectangle }
}

# Layer 5 — Infrastructure (decoupled!)
layer5: {
  label: "Layer 5 — Infrastructure Adapters"
  shape: rectangle
  style.fill: "#fff7ed"
  style.stroke: "#fdba74"

  middleware: { label: "middleware/\nParameterised recovery/trace\nCircuit breaker (fixed errors)\nValidation (preserve cause)" ; shape: rectangle }
  storage: { label: "storage/\nSQLEventStore\nSQLSnapshotStore\nSQLCheckpointStore\n(no listing dep!)" ; shape: rectangle ; style.stroke: "#22c55e" ; style.stroke-width: 3 }
  projection: { label: "projection/\nRunner (split replay.go)\nCapped backoff, timer cleanup" ; shape: rectangle }
  listing: { label: "listing/\nAggregate listing\nTombstone filtering" ; shape: rectangle }
  watermill: { label: "watermill/\nProtocol adapter\n(sync.Once, no MustParse)" ; shape: rectangle }
  pebble: { label: "pebble/\nPebbleDB store\n(no stutter naming)" ; shape: rectangle }
  turso: { label: "turso/\nTurso connector\n(with tests!)" ; shape: rectangle }
}

# Layer 6 — Integration & Tools
layer6: {
  label: "Layer 6 — Integration & Tools"
  shape: rectangle
  style.fill: "#f9fafb"
  style.stroke: "#d1d5db"

  catalog: { label: "catalog/\nRegistry (generic helpers)\nAsyncAPI, D2, OpenAPI\nEventCatalog (XSS fixed)" ; shape: rectangle }
  integration: { label: "integration/\nCross-module tests\n(all errors taxonomy here)" ; shape: rectangle }
  cqrs_gen: { label: "cmd/cqrs-gen/\nCode generator (fixed query sig)" ; shape: rectangle }
}

# Clean dependency edges
layer0.id -> layer1.event
layer0.codec -> layer1.event
layer0.dispatcher -> layer1.command
layer0.dispatcher -> layer1.query
layer0.id -> layer1.command

layer1.event -> layer2.schema
layer1.event -> layer2.snapshot

layer1.event -> layer3.decider
layer2.snapshot -> layer3.decider
layer4.otel -> layer3.decider

layer1.event -> layer4.memory
layer1.event -> layer4.signing

layer1.command -> layer5.middleware
layer1.event -> layer5.middleware
layer1.query -> layer5.middleware
layer4.otel -> layer5.middleware

layer1.event -> layer5.storage
layer2.snapshot -> layer5.storage

layer1.event -> layer5.projection
layer4.memory -> layer5.projection
layer4.otel -> layer5.projection

layer1.event -> layer5.listing
layer4.memory -> layer5.listing

layer1.event -> layer5.watermill
layer4.memory -> layer5.watermill

layer1.event -> layer5.pebble
layer0.codec -> layer5.pebble

layer5.storage -> layer5.turso

# Key improvements legend
improvements: {
  label: "Key Improvements"
  shape: rectangle
  near: bottom-center
  style.fill: "#f0fdf4"
  style.stroke: "#22c55e"

  i1: "✅ Zero module-level cycles (event/ test deps → integration/)"
  i2: "✅ decider/ no longer depends on memory/"
  i3: "✅ storage/ decoupled from listing/ (via shared contract)"
  i4: "✅ signing/ extractOrPassThrough shared (no duplication)"
  i5: "✅ All files under 250 lines"
  i6: "✅ No panics in signing middleware"
  i7: "✅ XSS fixed in catalog docserver"
  i8: "✅ Generic helpers in catalog registry"
}
