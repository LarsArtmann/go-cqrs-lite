title: go-cqrs-lite — Ideal Architecture (Target State)
direction: down

# Consumer Layer
consumer: {
  shape: rectangle
  style.fill: "#f0f0f0"

  http_api: "HTTP/gRPC API"
  cli: "CLI / Worker"
}

# CQRS Dispatchers (unchanged - already excellent)
dispatchers: {
  shape: rectangle
  style.fill: "#e3f2fd"

  cmd_dispatch: "Command Dispatcher" {
    middleware_stack: "Middleware Stack (6 concerns × 3 types = 21)"
  }
  query_dispatch: "Query Dispatcher" {
    typed_handler: "TypedHandler[T] (no more any)"
    pagination: "Pagination"
  }
}

# UNIFIED Repository (key improvement)
unified_repo: {
  shape: rectangle
  style.fill: "#c8e6c9"

  repo: "Repository[State]" {
    load: "Load (with snapshot fallback)"
    execute: "Execute (load → decide → save → publish)"
    persist: "Persist (transactional outbox / direct)"
    snapshot: "Snapshot (strategy + codec)"
  }

  adapters: "State Adapters" {
    oo_adapter: "RootAdapter (wraps aggregate.Root)"
    fn_adapter: "FoldAdapter (pure functions)"
  }
}

# Event System (consolidated)
event_system: {
  shape: rectangle
  style.fill: "#e8f5e9"

  types: "Types & Interfaces" {
    event: "Event (immutable, branded IDs)"
    store: "Store (CRUD + LoadAll)"
    bus: "Publisher + Subscriber"
    txn: "TransactionalStore"
  }

  runner: "Unified Runner" {
    simple: "Handle (sync dispatch)"
    replay: "Replay (GlobalLoader, position-aware)"
    live: "Live (Subscriber)"
    parallel: "HandleParallel (goroutines)"
    retry: "Retry (IsRetryable)"
    checkpoint: "Per-projection checkpoint"
  }

  helpers: "Shared Helpers" {
    publish: "PublishChanges"
    snapshot_save: "SaveSnapshot"
    should_snapshot: "ShouldSnapshot"
  }

  errors: "Error Taxonomy" {
    families: "5 Families (extensible)"
    classify: "Classify + RegisterClassification"
  }
}

# Storage (dialect-driven)
storage: {
  shape: rectangle
  style.fill: "#fce4ec"

  dialect: "Dialect Interface" {
    style.stroke: "#d32f2f"
    placeholders: "Placeholder style"
    ddl: "DDL generation (methods, not free funcs)"
    upsert: "Upsert syntax"
  }

  backends: "Backends" {
    pg: "PostgreSQL"
    sqlite: "SQLite"
    turso: "Turso"
    pebble: "Pebble KV"
  }
}

# Memory (testing only)
memory_mod: {
  shape: rectangle
  style.fill: "#f3e5f5"
  style.stroke-dash: 3
  label: "Testing Only"

  implementations: "MemoryStore + MemoryBus + MemorySnapshotStore + MemoryOutboxStore"
}

# Catalog (shared exporter interface)
catalog_mod: {
  shape: rectangle
  style.fill: "#fff9c4"

  registry: "Registry → Catalog (immutable)"

  exporter_iface: "Exporter Interface" {
    shape: hexagon
    style.stroke: "#f57f17"
  }

  exporters: "Concrete Exporters" {
    asyncapi: "AsyncAPI 3.0"
    openapi: "OpenAPI 3.0"
    d2_export: "D2 Diagrams"
    eventcatalog: "EventCatalog MDX"
    docserver: "Doc Server (HTTP)"
  }

  walk: "WalkMessages (shared iteration)"
}

# Sync Primitives (unchanged)
sync_mod: {
  shape: rectangle
  style.fill: "#e8eaf6"

  primitives: "VectorClock + Operation[T] + ConflictResolver[T]"
}

# Key improvements highlighted
improvements: {
  shape: rectangle
  style.fill: "#ffcdd2"
  style.stroke: "#d32f2f"

  "1. Unified Repository[State]": {
    style.bold: true
    detail: "aggregate + decider share one code path"
  }
  "2. Unified Runner": {
    style.bold: true
    detail: "projection/ merged into core/event\nInMemoryRunner + ReplayRunner\none module eliminated"
  }
  "3. Dialect Interface": {
    style.bold: true
    detail: "Schema DDL as methods, not free funcs\nstorage files: 7 → 4"
  }
  "4. Exporter Interface": {
    style.bold: true
    detail: "WalkMessages() shared iteration\nnew format = implement 4 methods"
  }
  "5. Clock Injection": {
    style.bold: true
    detail: "func() time.Time option in NewEvent\ndeterministic testing"
  }
}

# Dependencies
consumer -> dispatchers: "dispatches"
dispatchers -> unified_repo: "delegates to"
unified_repo -> event_system: "uses Store + Publisher"
event_system -> storage: "implements interfaces"
event_system -> memory_mod: "testing impl" {
  style.stroke-dash: 3
}
dispatchers -> catalog_mod: "introspect"
catalog_mod -> event_system: "uses types"
sync_mod -> event_system: "zero deps" {
  style.stroke: "#aaa"
}
