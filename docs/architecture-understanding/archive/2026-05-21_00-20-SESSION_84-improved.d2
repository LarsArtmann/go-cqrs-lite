direction: down

title: {
  label: go-cqrs-lite Target Architecture
  near: top-center
  shape: text
  style.font-size: 24
}

core: {
  style.fill: "#C8E6C9"

  event: {
    Event: {shape: hexagon}
    Publisher: {shape: hexagon}
    Subscriber: {shape: hexagon}
    Bus: {shape: hexagon}
    Store: {shape: hexagon}
    OutboxPublisher: {shape: diamond}
  }

  decider: {
    style.fill: "#A5D6A7"
    "Decider State": {shape: hexagon}
    "Repository State": {shape: diamond}
  }

  command: {
    Dispatcher: {shape: diamond}
  }

  query: {
    Dispatcher: {shape: diamond}
  }

  ids: {
    label: pkg/id
    "Branded IDs": {shape: hexagon}
  }

  generic: {
    label: pkg/dispatcher
    "Generic Dispatcher": {shape: diamond}
    Lifecycle: {shape: diamond}
  }
}

memory: {
  style.fill: "#BBDEFB"
  MemoryStore: {shape: cylinder}
  MemoryBus: {shape: cylinder}
}

catalog: {
  style.fill: "#E1BEE7"
  Registry: {shape: diamond}
  asyncapi: {shape: page}
  d2_export: {label: d2; shape: page}
  eventcatalog: {shape: page}
}

middleware: {
  style.fill: "#FFF9C4"
  Logging: {shape: rectangle}
  Metrics: {shape: rectangle}
  Recovery: {shape: rectangle}
  Retry: {shape: rectangle}
  Validation: {shape: rectangle}
}

tracing: {
  label: middleware/tracing (isolated module)
  style.fill: "#FFCDD2"
  "OTEL Tracing": {shape: rectangle}
}

projection: {
  style.fill: "#B2EBF2"
  Runner: {shape: diamond}
  HandlerRegistry: {shape: diamond}
}

storage: {
  style.fill: "#F8BBD0"
  SQLEventStore: {shape: cylinder}
  PebbleEventStore: {shape: cylinder}
  "Unified reconstructEvent": {shape: diamond; style.fill: "#A5D6A7"}
  Dialect: {shape: hexagon}
}

sync: {
  style.fill: "#DCEDC8"
  VectorClock: {shape: hexagon}
  LWWResolver: {shape: diamond}
}

removed: {
  label: "Removed in v2"
  style.fill: "#FFCDD2"
  style.stroke-dash: 5
  "aggregate package": {shape: rectangle}
  Catalogable: {shape: rectangle}
}

app: {
  label: Application Layer
  style.fill: "#CFD8DC"
  HTTP: {shape: rectangle}
}

app -> core.command: commands
app -> core.query: queries
app -> core.decider: load and execute
core.decider -> core.event: save and publish
core.command -> core.generic: uses
core.query -> core.generic: uses
core.event -> core.ids: uses
memory -> core.event: implements
memory -> core.generic: Lifecycle
middleware -> core.command: wraps
middleware -> core.event: wraps
middleware -> core.query: wraps
tracing -> core.event: wraps
projection -> core.event: Subscriber
catalog -> core.event: registerClassification
storage -> core.event: implements
