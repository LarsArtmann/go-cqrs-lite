direction: down
layout: elk

title: {
  label: go-cqrs-lite — Current Architecture
  shape: text
  near: top-center
  style.font-size: 24
}

# Layer 0: Leaf Modules
layer0: {
  label: Layer 0 — Leaf Modules
  style.fill: "#ecfdf5"
  style.stroke: "#059669"

  id: {
    label: id
    shape: rectangle
    style.fill: "#f0fdf4"
    style.stroke: "#059669"
  }
  dispatcher: {
    label: dispatcher
    shape: rectangle
    style.fill: "#f0fdf4"
    style.stroke: "#059669"
  }
  codec: {
    label: codec
    shape: rectangle
    style.fill: "#f0fdf4"
    style.stroke: "#059669"
  }
}

# Layer 1: Core Domain
layer1: {
  label: Layer 1 — Core Domain
  style.fill: "#eff6ff"
  style.stroke: "#3b82f6"

  event: {
    label: event
    shape: rectangle
    style.fill: "#dbeafe"
    style.stroke: "#3b82f6"
    # Interfaces
    EventSink: {label: "EventSink\nSave | AppendBatch"}
    EventSource: {label: "EventSource\nLoad | LoadFromVersion\nLoadToVersion | LoadToTimestamp"}
    Journal: {label: "Journal\nReadAll"}
    SeekableJournal: {label: "SeekableJournal\nReadFrom"}
    Bus: {label: "Bus\nPublish + Subscribe"}
    Handler: {label: "Handler\nfunc(ctx, Event) error"}
    EventSink -- EventSource: "Store composes both"
  }

  command: {
    label: command
    shape: rectangle
    style.fill: "#dbeafe"
    style.stroke: "#3b82f6"
    CommandSink: {label: "CommandSink\nSave"}
    CommandSource: {label: "CommandSource\nLoad"}
  }

  query: {
    label: query
    shape: rectangle
    style.fill: "#dbeafe"
    style.stroke: "#3b82f6"
    QueryDispatcher: {label: "QueryDispatcher\nDispatch | Register"}
  }
}

# Layer 2: Infrastructure Abstractions
layer2: {
  label: Layer 2 — Schema & Snapshot
  style.fill: "#fef3c7"
  style.stroke: "#d97706"

  schema: {
    label: schema
    shape: rectangle
    style.fill: "#fef9c3"
    style.stroke: "#d97706"
    Upcaster: {label: "Upcaster\nUpcast(Event) → Event"}
    VersionedStore: {label: "VersionedStore\nwraps Store + upcasters"}
  }

  snapshot: {
    label: snapshot
    shape: rectangle
    style.fill: "#fef9c3"
    style.stroke: "#d97706"
    SnapshotSink: {label: "SnapshotSink\nSave"}
    SnapshotSource: {label: "SnapshotSource\nLoad"}
  }
}

# Layer 3: Domain Patterns
layer3: {
  label: Layer 3 — Decider
  style.fill: "#f0f9ff"
  style.stroke: "#0ea5e9"

  decider: {
    label: decider
    shape: rectangle
    style.fill: "#e0f2fe"
    style.stroke: "#0ea5e9"
    Decider: {label: "Decider[State]\nInitial | Fold"}
    Repository: {label: "Repository[State]\nExecute | Load"}
    DecideFunc: {label: "DecideFunc\n(State, Command) → []Event"}
  }
}

# Layer 4: Test/Dev Infrastructure
layer4: {
  label: Layer 4 — Test & Dev Infra
  style.fill: "#faf5ff"
  style.stroke: "#8b5cf6"

  memory: {
    label: memory
    shape: rectangle
    style.fill: "#f3e8ff"
    style.stroke: "#8b5cf6"
    MemoryStore: {label: "MemoryStore\nStore + Journal\n+ Seekable + Backwards"}
    MemoryBus: {label: "MemoryBus"}
    MemorySnapshotStore: {label: "MemorySnapshotStore"}
  }

  signing: {
    label: signing
    shape: rectangle
    style.fill: "#f3e8ff"
    style.stroke: "#8b5cf6"
    HMAC: {label: "HMAC-SHA256"}
    Ed25519: {label: "Ed25519"}
    multisig: {label: "multisig"}
  }

  otel: {
    label: otel
    shape: rectangle
    style.fill: "#f3e8ff"
    style.stroke: "#8b5cf6"
  }
}

# Layer 5: Storage & Cross-cutting
layer5: {
  label: Layer 5 — Storage & Cross-cutting
  style.fill: "#fff7ed"
  style.stroke: "#f97316"

  middleware: {
    label: middleware (3× duplication)
    shape: rectangle
    style.fill: "#fee2e2"
    style.stroke: "#dc2626"
    Retry: {label: "Retry ×3"}
    Logging: {label: "Logging ×3"}
    Recovery: {label: "Recovery ×3"}
    Tracing: {label: "Tracing ×3"}
    Metrics: {label: "Metrics ×3"}
    CircuitBreaker: {label: "Circuit Breaker ×3"}
    Validation: {label: "Validation ×3"}
  }

  storage: {
    label: storage
    shape: rectangle
    style.fill: "#ffedd5"
    style.stroke: "#f97316"
    SQLEventStore: {label: "SQLEventStore\nPG / SQLite"}
    SQLSnapshotStore: {label: "SQLSnapshotStore"}
  }

  projection: {
    label: projection
    shape: rectangle
    style.fill: "#ffedd5"
    style.stroke: "#f97316"
    Runner: {label: "Runner\nreplay + live"}
    Builder: {label: "Builder\nOn[T]()"}
  }

  pebble: {
    label: pebble
    shape: rectangle
    style.fill: "#ffedd5"
    style.stroke: "#f97316"
  }

  listing: {
    label: listing
    shape: rectangle
    style.fill: "#ffedd5"
    style.stroke: "#f97316"
  }

  watermill: {
    label: watermill
    shape: rectangle
    style.fill: "#ffedd5"
    style.stroke: "#f97316"
  }

  turso: {
    label: turso
    shape: rectangle
    style.fill: "#ffedd5"
    style.stroke: "#f97316"
  }
}

# Layer 6: Integration & Tooling
layer6: {
  label: Layer 6 — Integration & Tooling
  style.fill: "#fef2f2"
  style.stroke: "#ef4444"

  integration: {
    label: integration
    shape: rectangle
    style.fill: "#fee2e2"
    style.stroke: "#ef4444"
  }

  catalog: {
    label: catalog
    shape: rectangle
    style.fill: "#fee2e2"
    style.stroke: "#ef4444"
    Registry: {label: "Registry"}
    AsyncAPI: {label: "AsyncAPI"}
    D2Exporter: {label: "D2"}
    EventCatalog: {label: "EventCatalog"}
    OpenAPI: {label: "OpenAPI"}
  }

  cqrs_gen: {
    label: cmd/cqrs-gen
    shape: rectangle
    style.fill: "#fee2e2"
    style.stroke: "#ef4444"
  }
}

# Dependencies
layer1.event -> layer0.id: "branded IDs"
layer1.event -> layer0.codec: "payload encode/decode"
layer1.event -> layer0.dispatcher: "LifecycleMixin"
layer1.command -> layer0.dispatcher: "Dispatcher[H,M]"
layer1.command -> layer1.event: "re-exports AggregateRef ⚠️"
layer1.command -> layer0.id: "branded IDs"
layer1.command -> layer0.codec: "payload codec"
layer1.query -> layer0.dispatcher: "Dispatcher[H,M]"

layer2.schema -> layer1.event: "upcasters"
layer2.schema -> layer0.id
layer2.schema -> layer0.codec
layer2.snapshot -> layer0.codec
layer2.snapshot -> layer1.event

layer3.decider -> layer1.event
layer3.decider -> layer0.id
layer3.decider -> layer4.memory
layer3.decider -> layer4.otel
layer3.decider -> layer2.snapshot

layer4.memory -> layer0.dispatcher
layer4.memory -> layer1.event
layer4.memory -> layer2.snapshot
layer4.signing -> layer1.event
layer4.signing -> layer0.id

layer5.middleware -> layer1.command: "3× middleware"
layer5.middleware -> layer1.event: "3× middleware"
layer5.middleware -> layer1.query: "3× middleware"
layer5.middleware -> layer4.otel
layer5.storage -> layer1.event
layer5.storage -> layer5.listing
layer5.storage -> layer4.otel
layer5.projection -> layer1.event
layer5.projection -> layer4.memory
layer5.projection -> layer4.otel
layer5.pebble -> layer1.event
layer5.watermill -> layer1.event
layer5.turso -> layer1.event
layer5.turso -> layer5.storage

layer6.integration -> layer1.command
layer6.integration -> layer3.decider
layer6.integration -> layer4.memory
layer6.integration -> layer5.middleware
layer6.integration -> layer5.projection
layer6.integration -> layer4.signing
layer6.integration -> layer5.storage
layer6.catalog -> layer1.event
