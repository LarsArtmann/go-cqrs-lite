title: go-cqrs-lite — Current Architecture (Session 74)
direction: down

# Consumer Layer
consumer: {
  shape: rectangle
  style.fill: "#f0f0f0"

  http_api: "HTTP/gRPC API" {
    style.stroke: "#666"
  }
  cli: "CLI / Worker" {
    style.stroke: "#666"
  }
}

# CQRS Dispatchers
dispatchers: {
  shape: rectangle
  style.fill: "#e3f2fd"

  cmd_dispatch: "Command Dispatcher" {
    shape: rectangle
    style.stroke: "#1565c0"
    middleware_stack: "Middleware Stack" {
      shape: rectangle
      logging: "Logging"
      metrics: "Metrics"
      retry: "Retry"
      recovery: "Recovery"
      validation: "Validation"
      tracing: "Tracing (OTel)"
    }
  }

  query_dispatch: "Query Dispatcher" {
    shape: rectangle
    style.stroke: "#7b1fa2"
    pagination: "Pagination" {
      shape: diamond
    }
  }
}

# Aggregate Patterns
aggregates: {
  shape: rectangle
  style.fill: "#fff3e0"

  aggregate_pkg: "aggregate (OO)" {
    shape: rectangle
    root: "Root interface"
    repo_oo: "EventSourcedRepository"
    snapshot_oo: "SnapshotStrategy"
    outbox_oo: "Outbox support"
  }

  decider_pkg: "decider (Pure)" {
    shape: rectangle
    decider_type: "Decider[State]"
    repo_fn: "Repository[State]"
    decide: "DecideFunc"
    fold: "Fold func"
  }

  shared: "Shared Logic" {
    shape: rectangle
    style.stroke-dash: 3
    snapshot_helper: "event.PublishChanges"
    publish_helper: "event.SaveSnapshot"
    strategy: "event.SnapshotStrategy"
  }
}

# Event System
event_system: {
  shape: rectangle
  style.fill: "#e8f5e9"

  interfaces: "Interfaces" {
    store: "Store" {
      shape: hexagon
    }
    bus: "Bus = Publisher + Subscriber" {
      shape: hexagon
    }
    snapshot_store: "SnapshotStore" {
      shape: hexagon
    }
    outbox: "Outbox" {
      shape: hexagon
    }
    txn_store: "TransactionalStore" {
      shape: hexagon
    }
    global_loader: "GlobalLoader" {
      shape: hexagon
    }
  }

  event_core: "Event Core" {
    new_event: "NewEvent (Version, SchemaVersion)"
    builder: "Builder API"
    metadata: "Metadata (12 options)"
    enricher: "ContextEnricher"
  }

  runners: "Runners" {
    in_memory_runner: "InMemoryRunner (sync)"
    handle_parallel: "HandleParallel (concurrent)"
    outbox_publisher: "OutboxPublisher (background)"
  }

  upcasting: "Upcasting" {
    registry: "UpcasterRegistry"
    cycle_detect: "Cycle Detection"
  }

  errors: "Error Taxonomy" {
    families: "5 Families: Rejection, Conflict, Transient, Corruption, Infrastructure"
    classify: "Classify(err) Family"
    register: "RegisterClassification (extensible)"
  }
}

# Storage Implementations
storage: {
  shape: rectangle
  style.fill: "#fce4ec"

  sql_stores: "SQL Stores" {
    pg: "PostgreSQL" {
      style.stroke: "#336791"
    }
    sqlite: "SQLite" {
      style.stroke: "#003B57"
    }
    turso: "Turso (libSQL)" {
      style.stroke: "#f47f2a"
    }
  }

  kv_store: "Key-Value Store" {
    pebble: "CockroachDB Pebble" {
      style.stroke: "#005fff"
    }
  }

  sql_helpers: "Shared SQL Helpers" {
    dialect: "Dialect (Postgres/SQLite)"
    scan: "scanEvents / insertEvents"
    outbox_sql: "Outbox SQL"
  }
}

# Memory Implementations (Testing)
memory_mod: {
  shape: rectangle
  style.fill: "#f3e5f5"
  style.stroke-dash: 3

  mem_store: "MemoryStore"
  mem_bus: "MemoryBus"
  mem_snapshot: "MemorySnapshotStore"
  mem_outbox: "MemoryOutboxStore"
  mem_checkpoint: "MemoryCheckpointStore"
}

# Projection
projection_mod: {
  shape: rectangle
  style.fill: "#e0f7fa"

  runner: "Runner" {
    replay: "Replay (GlobalLoader)"
    live: "Live (Subscriber)"
    retry: "Retry (IsRetryable)"
    checkpoint: "Per-projection checkpoint"
  }
  handler_reg: "HandlerRegistry"
}

# Catalog / Documentation
catalog_mod: {
  shape: rectangle
  style.fill: "#fff9c4"

  registry: "Registry (thread-safe)" {
    schema_reflect: "SchemaFromType[T] (reflect)"
  }

  exporters: "Exporters" {
    asyncapi: "AsyncAPI 3.0"
    openapi: "OpenAPI 3.0"
    d2_export: "D2 Diagrams"
    eventcatalog: "EventCatalog MDX"
    docserver: "Doc Server (HTTP)"
  }
}

# Sync Primitives
sync_mod: {
  shape: rectangle
  style.fill: "#e8eaf6"

  vector_clock: "VectorClock" {
    compare: "Compare (before/after/concurrent)"
    merge: "Merge (pointwise max)"
  }
  operation: "Operation[T]"
  conflict: "ConflictResolver[T]" {
    lww: "LWWResolver (Last-Write-Wins)"
  }
  sync_msg: "SyncMessage (Request/Response)"
}

# Dependencies
consumer -> dispatchers: "dispatches commands & queries"
consumer -> event_system: "creates events"
dispatchers -> event_system: "uses Store, Bus"
aggregates -> event_system: "persist + publish events"
aggregate_pkg -> shared: "uses helpers" {
  style.stroke-dash: 3
}
decider_pkg -> shared: "uses helpers" {
  style.stroke-dash: 3
}
event_system -> storage: "Store interface"
event_system -> memory_mod: "Store interface" {
  style.stroke-dash: 3
}
storage -> event_system: "implements Store, Bus, Outbox"
memory_mod -> event_system: "implements Store, Bus, Outbox"
event_system -> projection_mod: "GlobalLoader + Subscriber"
dispatchers -> catalog_mod: "introspect for docs"
catalog_mod -> event_system: "uses types"
sync_mod -> event_system: "zero deps" {
  style.stroke: "#aaa"
}
