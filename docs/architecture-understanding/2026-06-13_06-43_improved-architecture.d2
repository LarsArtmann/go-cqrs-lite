direction: down
title: go-cqrs-lite Improved Architecture (Target)

layer0: {
  label: Layer 0 — Leaf Modules (zero internal deps)
  id_module
  dispatcher_module
  codec_module
}

layer1: {
  label: Layer 1 — Core CQRS
  event: {shape: hexagon}
  command
  query
}

shared_encoding: {
  label: internal/encoding
}

reactive_bridge: {
  label: Reactive Bridge
  style.stroke: "#4f46e5"
}

layer2: {
  label: Layer 2 — Event Extensions
  schema
  snapshot
}

layer3: {
  label: Layer 3 — Aggregate Pattern
  decider
}

layer4: {
  label: Layer 4 — Cross-Cutting
  memory
  signing
  encryption
  otel
}

layer5: {
  label: Layer 5 — Infrastructure
  middleware
  storage: {shape: cylinder}
  projection
  listing
  watermill
  pebble: {shape: cylinder}
  turso: {shape: cylinder}
}

layer6: {
  label: Layer 6 — Consumers
  integration
  catalog_exporters: {
    label: catalog (split exporters)
    catalog_core
    catalog_asyncapi
    catalog_openapi
    catalog_d2
  }
  examples
  cqrs_gen
  api_stability
}

event -> id_module: "branded IDs"
event -> codec_module: "payload encoding"
event -> dispatcher_module: "middleware chain"
command -> id_module: "branded IDs"
command -> dispatcher_module: "generic dispatcher"
query -> dispatcher_module: "generic dispatcher"
schema -> event: "upcasts events"
snapshot -> event: "snapshot store"
decider -> event: "load/save events"
decider -> snapshot: "snapshot optimization"
memory -> event: "in-memory impl"
signing -> event: "sign/verify events"
signing -> shared_encoding: "shared base64 decode"
encryption -> event: "encrypt/decrypt payloads"
encryption -> shared_encoding: "shared base64 decode"
middleware -> event: "middleware factories"
storage -> event: "SQL store impl"
projection -> event: "replay + live"
listing -> event: "aggregate listing"
watermill -> event: "message adapter"
pebble -> event: "KV store impl"
turso -> storage: "Turso connector"
integration -> event: "E2E tests"
catalog_core -> event: "catalog generation"

reactive_bridge -> event: "bridges Bus ↔ ro.Subject"
event -> reactive_bridge: "Next() on publish"

catalog_core -> catalog_asyncapi: "exports"
catalog_core -> catalog_openapi: "exports"
catalog_core -> catalog_d2: "exports"
