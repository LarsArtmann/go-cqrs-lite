title: {
  label: go-cqrs-lite — Web Client Communication
  near: top-center
  shape: text
  style: {
    font-size: 28
    bold: true
    underline: true
    font-color: "#1a1a2e"
  }
}

subtitle: {
  label: "How Commands, Queries, Events & Projections flow from browser to read model and back"
  near: top-center
  shape: text
  style: {
    font-size: 13
    italic: true
    font-color: "#555555"
  }
}

# ─── Classes ──────────────────────────────────────────────────────────────────

