title: {
  label: go-cqrs-lite — Web Client Communication
  near: top-center
  shape: text
  style: {
    font-size: 28
    bold: true
    underline: true
    font-color: "#1a1a2e"
  }
}

subtitle: {
  label: "How Commands, Queries, Events & Projections flow from browser to read model and back"
  near: top-center
  shape: text
  style: {
    font-size: 13
    italic: true
    font-color: "#555555"
  }
}

# ─── Classes ──────────────────────────────────────────────────────────────────

classes: {
  client: {
    style: {
      fill: "#e3f2fd"
      stroke: "#1565c0"
      stroke-width: 2
      border-radius: 8
      font-color: "#0d47a1"
      bold: true
    }
  }
  transport: {
    style: {
      fill: "#fff3e0"
      stroke: "#e65100"
      stroke-width: 2
      border-radius: 6
      font-color: "#bf360c"
    }
  }
  write: {
    style: {
      fill: "#e8f5e9"
      stroke: "#2e7d32"
      stroke-width: 2
      border-radius: 6
      font-color: "#1b5e20"
    }
  }
  event: {
    style: {
      fill: "#fce4ec"
      stroke: "#c62828"
      stroke-width: 2
      border-radius: 6
      font-color: "#b71c1c"
