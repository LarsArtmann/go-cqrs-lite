# ─── CLIENT ──────────────────────────────────────────────────────────────────

Web Client: {
  class: client
  label: "Web Client\nSPA · React · Vue · Svelte"
  width: 240
  link: https://github.com/larsartmann/go-cqrs-lite
  tooltip: "Your frontend application — sends commands and queries, receives real-time events"
}

# ─── TRANSPORT ────────────────────────────────────────────────────────────────

HTTP API: {
  class: transport
  label: "HTTP API\nChi · Echo · Gin"
  width: 220
  tooltip: "Decode request → Command/Query, inject ContextEnricher (correlationID, userID, requestID, IP, UA), encode response"
}

SSE: {
  class: transport
  label: "SSE / WebSocket\nReal-time push"
  width: 180
  tooltip: "Subscribe to Event Bus, push filtered events to client in real-time"
}

# ─── CQRS DISPATCHERS ────────────────────────────────────────────────────────

Write: {
  class: write
  direction: down
  label: "Command Side"

  CmdD: {
    label: "Command Dispatcher\nUse → Register → Dispatch"
    class: write
    width: 220
    tooltip: "Routes commands to handlers. Middleware applied at Register time."
  }

  CmdMW: {
    shape: text
    label: "Recovery → Tracing → Logging\n→ Validation → Retry → Metrics"
    style: {
      font-size: 9
      italic: true
      font-color: "#546e7a"
    }
  }

  CmdH: {
    label: "Command Handler"
    class: write
    width: 220
    tooltip: "Loads aggregate, applies business logic, records events, saves via repository"
  }

  CmdD -> CmdMW -> CmdH: {
    style: {
      stroke: "#2e7d32"
      stroke-dash: 2
    }
  }
}

Read: {
  class: read
  direction: down
  label: "Query Side"

  QD: {
    label: "Query Dispatcher\nUse → Register → Dispatch"
    class: read
    width: 220
    tooltip: "Routes queries to handlers. Returns typed results via DispatchTyped[T]."
  }

  QMW: {
    shape: text
    label: "Recovery → Tracing → Logging\n→ Validation → Metrics"
    style: {
      font-size: 9
      italic: true
      font-color: "#546e7a"
    }
  }

  QH: {
    label: "Query Handler"
    class: read
    width: 220
    tooltip: "Reads from materialized read model built by projections"
  }

  QD -> QMW -> QH: {
    style: {
      stroke: "#6a1b9a"
      stroke-dash: 2
    }
  }
}

# ─── DOMAIN ───────────────────────────────────────────────────────────────────

Aggregate: {
  class: write
  shape: hexagon
  label: "Aggregate Root"
  width: 160
  style: {
    fill: "#c8e6c9"
    stroke: "#1b5e20"
    stroke-width: 3
    font-color: "#1b5e20"
    bold: true
  }
  tooltip: "Root interface: Apply(evt), RecordEvent(ctx, evt), UncommittedChanges(), MarkChangesAsCommitted()"
}

Repo: {
  class: infra
  label: "EventSourced\nRepository"
  width: 180
  tooltip: "Save: Store.Save → Outbox/Bus.Publish → Snapshot\nLoad: SnapshotStore.Load → Store.LoadFromVersion → Replay"
}

# ─── EVENT INFRA ──────────────────────────────────────────────────────────────

EventStore: {
  class: store
  label: "Event Store\nPostgreSQL"
  width: 160
  tooltip: "event.Store: Save (optimistic concurrency), Load, LoadFromVersion, Delete"
}

Outbox: {
  class: infra
  shape: queue
  label: "Outbox"
  width: 120
  style: {
    fill: "#eceff1"
    stroke: "#546e7a"
  }
  tooltip: "event.Outbox: Append (same TX as Store.Save), PollPending, Ack — guarantees at-least-once publishing"
}

Snapshot: {
  class: store
  label: "Snapshot Store\nPostgreSQL"
  width: 160
  tooltip: "event.SnapshotStore: Save, Load (latest), LoadAtVersion — accelerated aggregate replay"
}

Bus: {
  class: event
  shape: queue
  label: "Event Bus\nMemory · NATS · Kafka"
  width: 200
  style: {
    fill: "#fce4ec"
    stroke: "#c62828"
    font-color: "#b71c1c"
    bold: true
  }
  tooltip: "event.Bus: Publish, Subscribe(type), SubscribeAll — delivers domain events to projections and SSE/WS"
}

# ─── READ MODEL ───────────────────────────────────────────────────────────────

Projections: {
  class: read
  label: "Projections\nInMemoryRunner"
  width: 160
  tooltip: "Projection: Name, Handle(ctx, evt), EventTypes() — InMemoryRunner routes events and saves checkpoints"
}

ReadModel: {
  class: store
  label: "Read Model\nPostgreSQL · Redis"
  width: 180
  style: {
    fill: "#f3e5f5"
    stroke: "#6a1b9a"
    font-color: "#4a148c"
  }
  tooltip: "Materialized view updated by projections. Queried by Query Handlers."
}

# ─── CATALOG ──────────────────────────────────────────────────────────────────

Catalog: {
  class: docs
  label: "Catalog\nAuto-generated"
  width: 160
  tooltip: "AsyncAPI 3.0 YAML/JSON, EventCatalog MDX, SchemaFromType via reflect — auto-generated from Go types"
}

# ─── WRITE PATH CONNECTIONS ─────────────────────────────────────────────────

Web Client -> HTTP API: "1  POST /users\n   CreateUser cmd" {
  style: {
    stroke: "#1565c0"
    stroke-width: 3
    animated: true
  }
}

HTTP API -> Write.CmdD: "2  Dispatch(ctx, cmd)" {
  style: {
    stroke: "#2e7d32"
    stroke-width: 3
    animated: true
  }
}

Write.CmdH -> Aggregate: "3  Load → mutate\n   RecordEvent" {
  style: {
    stroke: "#1b5e20"
    stroke-width: 2
    stroke-dash: 3
  }
}

Write.CmdH -> Repo: "3  repo.Save(ctx, root)" {
  style: {
    stroke: "#2e7d32"
    stroke-width: 3
  }
}

Aggregate -> Repo: "Uncommitted\nChanges" {
  style: {
    stroke: "#1b5e20"
    stroke-width: 2
    stroke-dash: 3
  }
}

Repo -> EventStore: "4  Store.Save\n   (opt. concurrency)" {
  style: {
    stroke: "#f9a825"
    stroke-width: 3
  }
}

Repo -> Outbox: "5  Outbox.Append\n   (same TX)" {
  style: {
    stroke: "#546e7a"
    stroke-width: 2
    stroke-dash: 4
    animated: true
  }
}

Repo -> Snapshot: "5  Snapshot.Save\n   (if strategy)" {
  style: {
    stroke: "#f9a825"
    stroke-width: 2
    stroke-dash: 4
  }
}

Outbox -> Bus: "6  Poll → Publish → Ack\n   (background)" {
  style: {
    stroke: "#c62828"
    stroke-width: 2
    animated: true
  }
}

# ─── EVENT → PROJECTION CONNECTIONS ─────────────────────────────────────────

Bus -> Projections: "7  Bus.SubscribeAll\n   InMemoryRunner" {
  style: {
    stroke: "#c62828"
    stroke-width: 3
    animated: true
  }
}

Projections -> ReadModel: "8  Update read model\n   (idempotent)" {
  style: {
    stroke: "#6a1b9a"
    stroke-width: 2
  }
}

# ─── READ PATH CONNECTIONS ──────────────────────────────────────────────────

HTTP API -> Read.QD: "10  Dispatch(ctx, query)" {
  style: {
    stroke: "#6a1b9a"
    stroke-width: 3
    animated: true
  }
}

Read.QH -> ReadModel: "11  Read from\n    materialized view" {
  style: {
    stroke: "#6a1b9a"
    stroke-width: 3
  }
}

ReadModel -> Read.QH: "12  Result via\n    DispatchTyped" {
  style: {
    stroke: "#6a1b9a"
    stroke-width: 2
    stroke-dash: 3
  }
}

# ─── REAL-TIME PUSH CONNECTIONS ──────────────────────────────────────────────

Bus -> SSE: "7  Bus.Subscribe\n   (filtered)" {
  style: {
    stroke: "#e65100"
    stroke-width: 2
    animated: true
  }
}

SSE -> Web Client: "13  Push events\n    real-time" {
  style: {
    stroke: "#e65100"
    stroke-width: 3
    animated: true
  }
}

# ─── CATALOG CONNECTIONS ─────────────────────────────────────────────────────

Write.CmdD -> Catalog: "CatalogDispatcher" {
  style: {
    stroke: "#00838f"
    stroke-width: 1
    stroke-dash: 3
  }
}

Read.QD -> Catalog: "CatalogDispatcher" {
  style: {
    stroke: "#00838f"
    stroke-width: 1
    stroke-dash: 3
  }
}

Bus -> Catalog: "Event schemas" {
  style: {
    stroke: "#00838f"
    stroke-width: 1
    stroke-dash: 3
  }
}

# ─── LAYOUT HINTS ────────────────────────────────────────────────────────────

Web Client -> SSE: { style.opacity: 0 }
HTTP API -> Read: { style.opacity: 0 }
Write -> Read: { style.opacity: 0 }
Write -> Repo: { style.opacity: 0 }
Aggregate -> EventStore: { style.opacity: 0 }
EventStore -> Bus: { style.opacity: 0 }
Projections -> Catalog: { style.opacity: 0 }

# ─── LEGEND ───────────────────────────────────────────────────────────────────

Legend: {
  shape: rectangle
  style: {
    fill: "#fafafa"
    stroke: "#bdbdbd"
    border-radius: 8
  }

  title: {
    shape: text
    label: "Legend — Data Flow Steps"
    style: {
      bold: true
      font-size: 13
      font-color: "#212121"
    }
  }

  flow_steps: {
    shape: text
    label: " 1  Client sends command (POST)\n 2  Dispatch through middleware chain\n 3  Handler loads aggregate, applies business logic, records events\n 4  Repository persists to Event Store (optimistic concurrency)\n 5  Outbox.Append (same TX) + optional Snapshot\n 6  Background: Poll → Publish → Ack (reliable delivery)\n 7  Bus delivers events to Projections & SSE/WS\n 8  Projection updates read model (idempotent)\n 9  Client sends query (GET)\n10  Dispatch through middleware chain\n11  Handler reads materialized view\n12  Type-safe result via DispatchTyped\n13  Real-time push to client via SSE/WebSocket"
    style: {
      font-size: 11
      font-color: "#424242"
    }
  }

  colors: {
    shape: text
    label: "Blue   — Client / Transport\nGreen — Write side (Command / Aggregate)\nRed    — Events (Bus / Store)\nPurple — Read side (Query / Projection)\nYellow — Persistence (Store / Snapshot)\nOrange — Real-time push (SSE / WebSocket)\nCyan  — Auto-documentation (Catalog)"
    style: {
      font-size: 11
      font-color: "#424242"
    }
  }

  line_styles: {
    shape: text
    label: "Solid   — Synchronous data flow\nDashed  — Async / indirect flow\nAnimated — Event-driven flow"
    style: {
      font-size: 11
      font-color: "#424242"
    }
  }
}
