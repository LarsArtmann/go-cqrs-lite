      border-radius: 6
      font-color: "#bf360c"
    }
  }
  write: {
    style: {
      fill: "#e8f5e9"
      stroke: "#2e7d32"
      stroke-width: 2
      border-radius: 6
      font-color: "#1b5e20"
    }
