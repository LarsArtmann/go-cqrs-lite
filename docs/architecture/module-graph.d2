# go-cqrs-lite Module Dependency Graph
# Arrow direction: depends on → (e.g., "middleware → core" means middleware imports core)

direction: down

style: {
  fill: "#0d1117"
  stroke: "#30363d"
  stroke-width: 1
}

# ============================================================
# Layer 0: External Infrastructure (no internal deps)
# ============================================================
layer0: {
  label: Layer 0 | External Primitives
  style.fill: "#161b22"
  style.stroke: "#30363d"

  codec: {
    label: |go
      codec
      (event marshaling)
    |
    shape: rectangle
    style: {
      fill: "#1a7f37"
      stroke: "#3fb950"
      font-color: "#f0f6fc"
      stroke-width: 2
    }
  }

  otel: {
    label: |go
      otel
      (tracer, meter, spans,
      attribute constants)
    |
    shape: rectangle
    style: {
      fill: "#1a7f37"
      stroke: "#3fb950"
      font-color: "#f0f6fc"
      stroke-width: 2
    }
  }
}

# ============================================================
# Layer 1: Core (the heart of the library)
# ============================================================
layer1: {
  label: Layer 1 | Core
  style.fill: "#161b22"
  style.stroke: "#30363d"

  core: {
    label: |go
      core
      (command, query, event,
      decider, pkg/id, pkg/dispatcher)
    |
    shape: rectangle
    style: {
      fill: "#0969da"
      stroke: "#58a6ff"
      font-color: "#f0f6fc"
      stroke-width: 3
    }
  }
}

# ============================================================
# Layer 2: Test Helpers (depends on core)
# ============================================================
layer2: {
  label: Layer 2 | Test Helpers
  style.fill: "#161b22"
  style.stroke: "#30363d"

  testhelpers: {
    label: |go
      testhelpers
      (Noop/Failing/Panic handlers,
      FakeMetrics, AppendEventsHandler)
    |
    shape: rectangle
    style: {
      fill: "#8957e5"
      stroke: "#a371f7"
      font-color: "#f0f6fc"
      stroke-width: 2
    }
  }
}

# ============================================================
# Layer 3: Near-Core Modules (thin wrappers, minimal deps)
# ============================================================
layer3: {
  label: Layer 3 | Near-Core Modules
  style.fill: "#161b22"
  style.stroke: "#30363d"

  memory: {
    label: |go
      memory
      (MemoryStore, MemoryBus,
      MemorySnapshotStore)
    |
    shape: rectangle
    style: {
      fill: "#7d4e00"
      stroke: "#d29922"
      font-color: "#f0f6fc"
      stroke-width: 2
    }
  }

  catalog: {
    label: |go
      catalog
      (Registry, SchemaFromType,
      AsyncAPI/D2/EventCatalog/OpenAPI)
    |
    shape: rectangle
    style: {
      fill: "#7d4e00"
      stroke: "#d29922"
      font-color: "#f0f6fc"
      stroke-width: 2
    }
  }

  signing: {
    label: |go
      signing
      (HMAC-SHA256, Ed25519,
      signing middleware)
    |
    shape: rectangle
    style: {
      fill: "#7d4e00"
      stroke: "#d29922"
      font-color: "#f0f6fc"
      stroke-width: 2
    }
  }
}

# ============================================================
# Layer 4: Mid-Tier Modules (bridge infra → core)
# ============================================================
layer4: {
  label: Layer 4 | Mid-Tier Modules
  style.fill: "#161b22"
  style.stroke: "#30363d"

  middleware: {
    label: |go
      middleware
      (Logging, Recovery, Retry,
      Circuit Breaker, Validation,
      Metrics, Tracing)
    |
    shape: rectangle
    style: {
      fill: "#7d4e00"
      stroke: "#d29922"
      font-color: "#f0f6fc"
      stroke-width: 2
    }
  }

  saga: {
    label: |go
      saga
      (Runner, Definition, Step,
      Instance, compensation)
    |
    shape: rectangle
    style: {
      fill: "#7d4e00"
      stroke: "#d29922"
      font-color: "#f0f6fc"
      stroke-width: 2
    }
  }

  stream: {
    label: |go
      stream
      (Aggregate listing, tombstone,
      StatusMiddleware, SQL/projection readers)
    |
    shape: rectangle
    style: {
      fill: "#7d4e00"
      stroke: "#d29922"
      font-color: "#f0f6fc"
      stroke-width: 2
    }
  }

  watermill: {
    label: |go
      watermill
      (Watermill protocol adapter,
      publisher/subscriber)
    |
    shape: rectangle
    style: {
      fill: "#7d4e00"
      stroke: "#d29922"
      font-color: "#f0f6fc"
      stroke-width: 2
    }
  }
}

# ============================================================
# Layer 5: Higher Modules (compose lower layers)
# ============================================================
layer5: {
  label: Layer 5 | Higher Modules
  style.fill: "#161b22"
  style.stroke: "#30363d"

  storage: {
    label: |go
      storage
      (SQLEventStore, SQLSnapshotStore,
      SQLOutbox, SQLCheckpointStore)
    |
    shape: rectangle
    style: {
      fill: "#7d4e00"
      stroke: "#d29922"
      font-color: "#f0f6fc"
      stroke-width: 2
    }
  }

  projection: {
    label: |go
      projection
      (Runner: replay+live,
      HandlerRegistry, Builder.On[T]())
    |
    shape: rectangle
    style: {
      fill: "#7d4e00"
      stroke: "#d29922"
      font-color: "#f0f6fc"
      stroke-width: 2
    }
  }

  pebble: {
    label: |go
      pebble
      (Pebble-backed stores)
    |
    shape: rectangle
    style: {
      fill: "#7d4e00"
      stroke: "#d29922"
      font-color: "#f0f6fc"
      stroke-width: 2
    }
  }

  turso: {
    label: |go
      turso
      (Turso-backed stores)
    |
    shape: rectangle
    style: {
      fill: "#7d4e00"
      stroke: "#d29922"
      font-color: "#f0f6fc"
      stroke-width: 2
    }
  }
}

# ============================================================
# Layer 6: Examples & Integration Tests
# ============================================================
layer6: {
  label: Layer 6 | Examples & Integration
  style.fill: "#161b22"
  style.stroke: "#30363d"

  examples: {
    label: |go
      example/*
      (projection, saga, storage,
      stream, todo, user)
    |
    shape: rectangle
    style: {
      fill: "#9e3670"
      stroke: "#f778ba"
      font-color: "#f0f6fc"
      stroke-width: 2
    }
  }

  integration: {
    label: |go
      integration
      (cross-module tests:
      command, event, query)
    |
    shape: rectangle
    style: {
      fill: "#9e3670"
      stroke: "#f778ba"
      font-color: "#f0f6fc"
      stroke-width: 2
    }
  }
}

# ============================================================
# Layer 7: Tools
# ============================================================
layer7: {
  label: Layer 7 | Tools
  style.fill: "#161b22"
  style.stroke: "#30363d"

  cqrs_gen: {
    label: |go
      cmd/cqrs-gen
      (code generation tool)
    |
    shape: rectangle
    style: {
      fill: "#484f58"
      stroke: "#8b949e"
      font-color: "#f0f6fc"
      stroke-width: 2
    }
  }
}

# ============================================================
# EDGES: Production Dependencies
# Arrow = "imports / depends on"
# ============================================================

# Layer 0 → Layer 1
core -> codec: {style.stroke: "#3fb950"; style.stroke-width: 2}
core -> otel: {style.stroke: "#3fb950"; style.stroke-width: 2}

# Layer 1 → Layer 2
testhelpers -> core: {style.stroke: "#a371f7"; style.stroke-width: 2}
testhelpers -> saga: {style.stroke: "#a371f7"; style.stroke-width: 2}

# Layer 1 → Layer 3
memory -> core: {style.stroke: "#d29922"; style.stroke-width: 2}
# catalog: no internal deps
signing -> core: {style.stroke: "#d29922"; style.stroke-width: 2}

# Layer 3 → Layer 4
middleware -> core: {style.stroke: "#d29922"; style.stroke-width: 2}
middleware -> otel: {style.stroke: "#3fb950"; style.stroke-width: 2}

saga -> core: {style.stroke: "#d29922"; style.stroke-width: 2}
saga -> otel: {style.stroke: "#3fb950"; style.stroke-width: 2}

stream -> core: {style.stroke: "#d29922"; style.stroke-width: 2}
stream -> memory: {style.stroke: "#d29922"; style.stroke-width: 2}

watermill -> core: {style.stroke: "#d29922"; style.stroke-width: 2}
watermill -> memory: {style.stroke: "#d29922"; style.stroke-width: 2}

# Layer 4 → Layer 5
storage -> core: {style.stroke: "#d29922"; style.stroke-width: 2}
storage -> otel: {style.stroke: "#3fb950"; style.stroke-width: 2}
storage -> saga: {style.stroke: "#d29922"; style.stroke-width: 2}

projection -> core: {style.stroke: "#d29922"; style.stroke-width: 2}
projection -> memory: {style.stroke: "#d29922"; style.stroke-width: 2}
projection -> otel: {style.stroke: "#3fb950"; style.stroke-width: 2}

pebble -> core: {style.stroke: "#d29922"; style.stroke-width: 2}

turso -> core: {style.stroke: "#d29922"; style.stroke-width: 2}
turso -> storage: {style.stroke: "#d29922"; style.stroke-width: 2}

# Layer 5/3/4 → Layer 6 (examples compose everything)
examples -> core: {style.stroke: "#f778ba"; style.stroke-width: 1}
examples -> memory: {style.stroke: "#f778ba"; style.stroke-width: 1}
examples -> middleware: {style.stroke: "#f778ba"; style.stroke-width: 1}
examples -> projection: {style.stroke: "#f778ba"; style.stroke-width: 1}
examples -> saga: {style.stroke: "#f778ba"; style.stroke-width: 1}
examples -> signing: {style.stroke: "#f778ba"; style.stroke-width: 1}
examples -> storage: {style.stroke: "#f778ba"; style.stroke-width: 1}
examples -> stream: {style.stroke: "#f778ba"; style.stroke-width: 1}
examples -> catalog: {style.stroke: "#f778ba"; style.stroke-width: 1}
examples -> codec: {style.stroke: "#f778ba"; style.stroke-width: 1}
examples -> pebble: {style.stroke: "#f778ba"; style.stroke-width: 1}
examples -> turso: {style.stroke: "#f778ba"; style.stroke-width: 1}

integration -> core: {style.stroke: "#f778ba"; style.stroke-width: 1}
integration -> memory: {style.stroke: "#f778ba"; style.stroke-width: 1}
integration -> middleware: {style.stroke: "#f778ba"; style.stroke-width: 1}
integration -> otel: {style.stroke: "#f778ba"; style.stroke-width: 1}
integration -> projection: {style.stroke: "#f778ba"; style.stroke-width: 1}
integration -> signing: {style.stroke: "#f778ba"; style.stroke-width: 1}
integration -> storage: {style.stroke: "#f778ba"; style.stroke-width: 1}

# ============================================================
# Test-only edges (dashed, lighter)
# These appear in go.mod but are only for _test.go files
# ============================================================
core -> memory: {
  style.stroke: "#d29922"
  style.stroke-dash: 5
  style.stroke-width: 1
}
core -> testhelpers: {
  style.stroke: "#a371f7"
  style.stroke-dash: 5
  style.stroke-width: 1
}

memory -> testhelpers: {
  style.stroke: "#a371f7"
  style.stroke-dash: 5
  style.stroke-width: 1
}

middleware -> testhelpers: {
  style.stroke: "#a371f7"
  style.stroke-dash: 5
  style.stroke-width: 1
}

saga -> testhelpers: {
  style.stroke: "#a371f7"
  style.stroke-dash: 5
  style.stroke-width: 1
}

signing -> testhelpers: {
  style.stroke: "#a371f7"
  style.stroke-dash: 5
  style.stroke-width: 1
}

storage -> testhelpers: {
  style.stroke: "#a371f7"
  style.stroke-dash: 5
  style.stroke-width: 1
}

projection -> testhelpers: {
  style.stroke: "#a371f7"
  style.stroke-dash: 5
  style.stroke-width: 1
}

watermill -> testhelpers: {
  style.stroke: "#a371f7"
  style.stroke-dash: 5
  style.stroke-width: 1
}

integration -> testhelpers: {
  style.stroke: "#a371f7"
  style.stroke-dash: 5
  style.stroke-width: 1
}
