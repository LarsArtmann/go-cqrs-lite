+	fields["amount"] = map[string]any{
+		"cents":    fields["amountCents"],
+		"currency": currency,
+	}
+	fields["reserved"] = map[string]any{
+		"cents":    fields["reservedCents"],
+		"currency": currency,
+	}
+
+	delete(fields, "currency")
+	delete(fields, "amountCents")
+	delete(fields, "reservedCents")
+
+	return fields, nil
 }
