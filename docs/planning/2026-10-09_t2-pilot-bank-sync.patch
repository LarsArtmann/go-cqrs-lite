+// upcastBalanceUpdatedV1 reshapes a v1 payload (flat cents fields with a
+// shared currency) into the v2 nested MoneyPayload layout.
+func upcastBalanceUpdatedV1(fields map[string]any) (map[string]any, error) {
+	currency, hasCurrency := fields["currency"]
+	if !hasCurrency {
+		return nil, errorfamily.NewCorruption(
+			"upcast.missing_currency",
+			"BalanceUpdated v1 payload missing required 'currency' field",
 		)
-	})
+	}
